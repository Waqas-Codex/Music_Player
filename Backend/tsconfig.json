{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "CommonJS",
    "target": "esnext",

    "types": ["node"],
    "lib": ["esnext"],

    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,

    "skipLibCheck": true,

    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "prisma.config.ts"]
}
